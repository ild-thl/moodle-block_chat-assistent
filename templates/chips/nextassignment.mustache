{{!
    @template block_sidekick/chips/nextassignment

    Chip button template for navigating to the next assignment.
    Displays a button that triggers the next assignment intent.

    Classes used:
    - chip
    - c-ic

    Data attributes:
    - None

    Context variables required for this template:
    - courseid: The course ID for the current context

    Example context (json):
    {
        "courseid": 123
    }

    Component: block_sidekick
    File: templates/chips/nextassignment.mustache
}}

<button id="nextAssignment" class="chip" >
    <span class="c-ic" aria-hidden="true">&#128197;</span> {{#str}}next_assignment, block_sidekick{{/str}}
</button>


{{^element.frozen}}
    {{#js}}
        require(['block_sidekick/chips/nextassignment'], function(js) {
        js.entry({{courseid}});
        });
    {{/js}}
{{/element.frozen}}
