<div class="block_sidekick_assistantinput">
    <form>
        <label for="assistField" class="visually-hidden">Promptinput</label>
        <input type="text" required id="assistField" placeholder="Frag mich etwas …">
        <button type="submit" id="assistFieldButton" aria-label="Senden"><span aria-hidden="true">&#10148;</span></button>
    </form>
</div>

{{^element.frozen}}
    {{#js}}
        require(['block_sidekick/assistantinput'], function(js) {
        js.entry({{courseid}});
        });
    {{/js}}
{{/element.frozen}}
